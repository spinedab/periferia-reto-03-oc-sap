# ============================================================================
# Reto 03 — Agente Conversacional Órdenes de Compra SAP (Periferia IT Group)
# Autor: Santiago Pineda Botero
# ============================================================================

# Puerto HTTP del servidor (sirve API y Frontend Web en un único puerto)
PORT=3000

# Proveedor LLM activo: "gemini" | "openai" | "anthropic" | "deterministic"
LLM_PROVIDER=gemini

# Modelo a utilizar según el proveedor elegido:
# - gemini: gemini-2.5-flash (recomendado por latencia/costo) o gemini-2.5-pro
# - openai: gpt-4o-mini o gpt-4o
# - anthropic: claude-3-5-haiku-latest o claude-3-7-sonnet-latest
# - deterministic: orquestador determinista sin consumo de API externa (contingencia/pruebas)
LLM_MODEL=gemini-2.5-flash

# Credenciales de proveedores (NUNCA subir valores reales al repositorio)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# Límites de seguridad, costos y disponibilidad del ciclo del agente (Sección 8 PRD)
AGENT_MAX_ITERATIONS=25
SESSION_MAX_TOKENS=120000
LLM_TIMEOUT_MS=30000

# Fallback automático al orquestador determinista si el proveedor LLM falla por cuota/red
LLM_FALLBACK_DETERMINISTIC=false

# Política de confirmación humana para creación de OC:
# - "prd" (por defecto): crea directo si apta=true y sin confirmaciones (ej. sol-001); exige confirmación humana si hay confirmaciones (RC5, RC6, RC8, RC9) o si el usuario lo pide explícitamente.
# - "always": exige confirmación humana antes de cualquier llamada a oc_crear, incluso sin excepciones.
CONFIRM_POLICY=prd
